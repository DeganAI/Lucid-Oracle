# Lucid Oracle Environment Configuration
# Copy this file to .env and configure your values

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ============================================
# WALLET ADDRESSES
# ============================================
# Your Base L2 wallet address (primary payment receiver)
AGENT_WALLET_ADDRESS_BASE=0x11c24Fbcd702cd611729F8402d8fB51ECa75Ba83

# Your Ethereum mainnet wallet address
AGENT_WALLET_ADDRESS_ETH=0x11c24Fbcd702cd611729F8402d8fB51ECa75Ba83

# Your Solana wallet address
AGENT_WALLET_ADDRESS_SOLANA=2x4BRUreTFZCaCKbGKVXFYD5p2ZUBpYaYjuYsw9KYhf3

# ============================================
# NETWORK CONFIGURATION
# ============================================
# Network name (base, ethereum, etc.)
NETWORK_NAME=base

# Chain ID (8453 for Base L2)
CHAIN_ID=8453

# RPC URL for Base L2
RPC_URL=https://mainnet.base.org

# USDC token address on Base L2
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ============================================
# x402 PROTOCOL CONFIGURATION
# ============================================
# Daydreams facilitator URL
X402_FACILITATOR=https://facilitator.daydreams.systems

# x402 protocol version
X402_VERSION=1

# ============================================
# CIRCUIT CONFIGURATION
# ============================================
# Path to circuit files (zkey, wasm, vkey)
CIRCUIT_PATH=./circuits

# Circuit execution timeout (milliseconds)
CIRCUIT_TIMEOUT_MS=60000

# ============================================
# PRICING CONFIGURATION (USDC, 6 decimals)
# ============================================
# Basic tier: $0.02 (20,000 = 0.02 USDC with 6 decimals)
PRICE_BASIC=20000

# Standard tier: $0.05 (50,000 = 0.05 USDC)
PRICE_STANDARD=50000

# Premium tier: $0.10 (100,000 = 0.10 USDC)
PRICE_PREMIUM=100000

# ============================================
# RATE LIMITING
# ============================================
# Rate limit window (milliseconds)
RATE_LIMIT_WINDOW_MS=60000

# Max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# OPTIONAL: MONITORING & ANALYTICS
# ============================================
# Uncomment and configure if using monitoring services

# SENTRY_DSN=https://your-sentry-dsn
# ANALYTICS_API_KEY=your-analytics-key
# MONITORING_ENDPOINT=https://your-monitoring-service
